# =============================================================================
# .gitignore — proyecto AWEBO
# Reglas relativas a la raíz del proyecto.
# =============================================================================

# -----------------------------------------------------------------------------
# Secretos y entorno
# -----------------------------------------------------------------------------
# Cualquier .env real fuera del repo. .env.example SÍ se sube (plantilla).
.env
.env.*
!.env.example

# Credenciales / claves sueltas que pudieran caer aquí por error
*.pem
*.key
*.p12
*.pfx
secrets/
**/secrets/

# -----------------------------------------------------------------------------
# Tests: en AWEBO SÍ se versionan (a diferencia del TFG). Solo se ignoran
# los artefactos de ejecución.
# -----------------------------------------------------------------------------
api/.pytest_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Artefactos de exportación generados en pruebas manuales
test_export.pdf
test_export.docx
*.tmp.pdf
*.tmp.docx

# -----------------------------------------------------------------------------
# Bases de datos y volúmenes persistentes
# -----------------------------------------------------------------------------
# Postgres corre en Docker; nunca debe haber datos reales en el repo.
postgres/data/
postgres/pgdata/
pgdata/
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.dump
*.backup
backups/

# Redis (por si se persiste localmente fuera de Docker)
dump.rdb
appendonly.aof

# -----------------------------------------------------------------------------
# Subidas / generaciones de usuario en runtime
# -----------------------------------------------------------------------------
api/app/static/uploads/
api/app/exports/
api/instance/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
api/logs/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Entornos virtuales
.venv/
venv/
env/

# -----------------------------------------------------------------------------
# Node (por si se introdujese tooling de frontend en el futuro)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# IDE y sistema operativo
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# Docker / Compose overrides locales
# -----------------------------------------------------------------------------
docker-compose.override.local.yml
*.local

# -----------------------------------------------------------------------------
# Herramientas locales de un solo uso
# -----------------------------------------------------------------------------
# `scripts/` contiene utilidades atadas a la máquina de su autor: la migración
# de datos del TFG lleva rutas de Windows y nombres de contenedor concretos.
# No aportan nada a quien clone el repositorio y sí exponen la estructura de
# carpetas personal, así que se quedan fuera del repositorio público.
scripts/

# -----------------------------------------------------------------------------
# Documentación de desarrollo
# -----------------------------------------------------------------------------
# `docs/` contiene documentación de desarrollo y notas internas que no son
# necesarias para el funcionamiento de la aplicación.
docs/

# -----------------------------------------------------------------------------
# Notas de desarrollo para asistentes de IA
# -----------------------------------------------------------------------------
# `CLAUDE.md` contiene reglas de trabajo específicas para asistentes de IA
# y no es necesario para el funcionamiento de la aplicación.
CLAUDE.md

# -----------------------------------------------------------------------------
# Datos y artefactos generados offline
# -----------------------------------------------------------------------------
resultados_estudio/
scratch/


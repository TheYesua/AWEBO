#: app/templates/accesibilidad.html:13
msgid "La aplicación se ha diseñado conforme a las <abbr title=\"Web Content Accessibility Guidelines\">WCAG</abbr> 2.1 nivel AA."
msgstr "La aplicación se ha diseñado conforme a las <abbr title=\"Web Content Accessibility Guidelines\">WCAG</abbr> 2.1 nivel AA."

#: app/templates/accesibilidad.html:18
msgid "Características incluidas"
msgstr "Características incluidas"

#: app/templates/accesibilidad.html:20
msgid "Enlace <strong>«Pasar al contenido principal»</strong> al inicio de cada página."
msgstr "Enlace <strong>«Pasar al contenido principal»</strong> al inicio de cada página."

#: app/templates/accesibilidad.html:21
msgid "Foco visible reforzado (no depende solo del color)."
msgstr "Foco visible reforzado (no depende solo del color)."

#: app/templates/accesibilidad.html:22
msgid "Navegación completa por teclado: <kbd>Tab</kbd>/<kbd>Mayús+Tab</kbd> para moverse, <kbd>Intro</kbd> para activar, <kbd>Esc</kbd> para cerrar diálogos."
msgstr "Navegación completa por teclado: <kbd>Tab</kbd>/<kbd>Mayús+Tab</kbd> para moverse, <kbd>Intro</kbd> para activar, <kbd>Esc</kbd> para cerrar diálogos."

#: app/templates/accesibilidad.html:23
msgid "Etiquetas y encabezados semánticos (<code>&lt;header&gt;</code>, <code>&lt;nav&gt;</code>, <code>&lt;main&gt;</code>, <code>&lt;footer&gt;</code>, <code>&lt;h1&gt;–&lt;h4&gt;</code>)."
msgstr "Etiquetas y encabezados semánticos (<code>&lt;header&gt;</code>, <code>&lt;nav&gt;</code>, <code>&lt;main&gt;</code>, <code>&lt;footer&gt;</code>, <code>&lt;h1&gt;–&lt;h4&gt;</code>)."

#: app/templates/accesibilidad.html:24
msgid "Imágenes con texto alternativo y SVGs decorativos marcados con <code>aria-hidden</code>."
msgstr "Imágenes con texto alternativo y SVGs decorativos marcados con <code>aria-hidden</code>."

#: app/templates/accesibilidad.html:25
msgid "Formularios con <code>label</code> asociado, mensajes de error anunciados a lectores de pantalla y campos con <code>aria-invalid</code> cuando procede."
msgstr "Formularios con <code>label</code> asociado, mensajes de error anunciados a lectores de pantalla y campos con <code>aria-invalid</code> cuando procede."

#: app/templates/accesibilidad.html:26
msgid "Contraste de texto mínimo 4.5:1 (3:1 en texto grande)."
msgstr "Contraste de texto mínimo 4.5:1 (3:1 en texto grande)."

#: app/templates/accesibilidad.html:27
msgid "Información que no se transmite solo mediante color (iconos lingüísticos, texto y formas refuerzan los estados)."
msgstr "Información que no se transmite solo mediante color (iconos lingüísticos, texto y formas refuerzan los estados)."

#: app/templates/accesibilidad.html:34
#, python-format
msgid "Diseño adaptable a móvil, tableta y escritorio; el contenido no se pierde al ampliar hasta el 200%%."
msgstr "Diseño adaptable a móvil, tableta y escritorio; el contenido no se pierde al ampliar hasta el 200%%."

#: app/templates/accesibilidad.html:35
msgid "Animaciones reducidas si el sistema indica <code>prefers-reduced-motion: reduce</code>."
msgstr "Animaciones reducidas si el sistema indica <code>prefers-reduced-motion: reduce</code>."

#: app/templates/accesibilidad.html:36
msgid "<a href=\"/mapa-web\">Mapa web</a> para navegación alternativa."
msgstr "<a href=\"/mapa-web\">Mapa web</a> para navegación alternativa."

#: app/templates/accesibilidad.html:37
msgid "Lectura en voz alta de cada sección de una situación, con la voz que el sistema tenga instalada. No requiere conexión ni servicio externo."
msgstr "Lectura en voz alta de cada sección de una situación, con la voz que el sistema tenga instalada. No requiere conexión ni servicio externo."

#: app/templates/accesibilidad.html:42
msgid "Limitaciones conocidas"
msgstr "Limitaciones conocidas"

#: app/templates/accesibilidad.html:44
msgid "Esta aplicación es un Trabajo de Fin de Grado en evaluación continua. Si detectas alguna barrera de accesibilidad, puedes comunicarla en la sección de <a href=\"/ayuda\">Ayuda</a>."
msgstr "Esta aplicación es un Trabajo de Fin de Grado en evaluación continua. Si detectas alguna barrera de accesibilidad, puedes comunicarla en la sección de <a href=\"/ayuda\">Ayuda</a>."


# =============================================================================
# AWEBO — copia este fichero a `.env` y rellena los valores
# =============================================================================

# --- Flask ---
FLASK_ENV=development
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria-larga

# --- PostgreSQL ---
POSTGRES_USER=awebo_user
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=awebo
POSTGRES_PORT=5433

# --- IA ---
# AI_PROVIDER: "openai", "gemini", "fake" (determinista, sin red, para
# desarrollo/tests) o vacío (auto: openai si hay api key).
AI_PROVIDER=gemini
# Obtén tu clave en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-5.4
# Obtén tu clave en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_MODEL=gemini-3.5-flash

# Modelos ADICIONALES que se ofrecerán al usuario en su perfil, separados por
# comas. El modelo de arriba (OPENAI_MODEL / GEMINI_MODEL) siempre aparece el
# primero y es el que se usa por defecto.
#
# Formato de cada entrada: "id-de-api" o "id-de-api|Etiqueta legible". La
# etiqueta es lo único que ve el docente, y NO puede contener comas.
#
# Comprobados contra la documentación oficial el 2026-08-03:
#   developers.openai.com/api/docs/models  ·  ai.google.dev/gemini-api/docs/models
OPENAI_MODELOS=gpt-5.4|GPT-5.4 — el configurado por defecto, gpt-5.6-sol|GPT-5.6 Sol — máxima capacidad, gpt-5.6-terra|GPT-5.6 Terra — equilibrado, gpt-5.6-luna|GPT-5.6 Luna — el más económico
GEMINI_MODELOS=gemini-3.5-flash|Gemini 3.5 Flash — el configurado por defecto, gemini-3.6-flash|Gemini 3.6 Flash — el más reciente, gemini-3.5-flash-lite|Gemini 3.5 Flash-Lite — rápido y económico, gemini-3.1-flash-lite|Gemini 3.1 Flash-Lite — el más barato

# --- Puertos expuestos en host ---
NGINX_PORT=8090
ADMINER_PORT=8091

# =============================================================================
# Correo electrónico
# =============================================================================
# 'consola' (por defecto): NO envía nada, escribe el mensaje en el registro.
#   El enlace de restablecimiento sale ahí, así que el flujo se puede probar
#   entero sin servidor de correo:
#       docker compose logs -f api | Select-String "enlace"
# 'smtp': envía de verdad. Vale cualquier servicio de envío transaccional,
#   todos ofrecen SMTP.
CORREO_PROVEEDOR=consola
CORREO_REMITENTE=AWEBO <no-responder@ejemplo.es>

# Solo se usan con CORREO_PROVEEDOR=smtp.
#
# DÉJALAS VACÍAS para desarrollo: el docker-compose.override.yml apunta api y
# worker al buzón de pruebas local (servicio `mailpit`), que acepta cualquier
# correo y no entrega nada a internet. La bandeja se ve en
# http://localhost:8025 — así se prueba el camino real de SMTP, cosa que el
# proveedor de consola no hace.
#
# Para un servicio de envío de verdad, rellénalas. El puerto 465 habla TLS
# desde el primer byte; el 587 empieza en claro y sube con STARTTLS. El código
# elige uno u otro según el puerto.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT=15

# Renuncia al cifrado. Solo para el buzón de pruebas local, que no ofrece
# STARTTLS. Con SMTP_USER puesto, el envío se niega a salir: mandaría la
# contraseña en claro. Déjala vacía para cualquier proveedor real.
SMTP_SIN_TLS=

# Puertos del buzón de pruebas en el host. Solo existe en desarrollo.
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base de los enlaces que viajan por correo. Absoluta: un enlace relativo en
# un cliente de correo no lleva a ninguna parte.
URL_BASE=http://localhost:8090
